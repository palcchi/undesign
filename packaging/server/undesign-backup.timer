# Runs undesign-backup.service every night (see that file).
#   sudo systemctl enable --now undesign-backup.timer
#   systemctl list-timers undesign-backup.timer

[Unit]
Description=Nightly backup of undesign-server's data directory

[Timer]
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
