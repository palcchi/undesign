<?xml version="1.0" encoding="utf-8"?>
<!--
  Undesign MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build undesign.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc undesign.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -d HasCli=1 -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder
  (Program Files\Undesign by default, remembered for upgrades), Ready, a progress page, and a
  Finish page with a ticked "Launch Undesign" box. Installs a Start Menu shortcut, makes
  Undesign the owner of `.undesign`, and offers it under "Open with" for SVG, PNG and JPEG
  (without taking over the user's default app for them), plus undesign-cli when HasCli=1.
  `msiexec /qn` still installs silently.

  UpgradeCode is fixed for Undesign forever (generated once; never reuse another app's).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Undesign"
      Manufacturer="Undesign"
      Version="$(var.Version)"
      UpgradeCode="2F33628E-FAEB-4F1A-9577-73C0984A9867"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Undesign interface design and prototyping tool" Manufacturer="Undesign" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Undesign is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="UndesignIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="UndesignIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/palcchi/undesign" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/palcchi/undesign" />
    <Property Id="ARPHELPLINK" Value="https://github.com/palcchi/undesign" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Undesign" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by UndesignApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\Undesign" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="Undesign" Level="1">
      <ComponentGroupRef Id="UndesignFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchUndesign"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through undesign.en-us.wxl. -->
    <Property Id="UndesignVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Undesign $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Undesign" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#UndesignExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchUndesign" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="UndesignFiles" Directory="INSTALLFOLDER">
      <Component Id="UndesignApp" Guid="6B5B91D8-68BB-4120-99CC-BE75D3AE1DC1">
        <File Id="UndesignExe" Source="$(var.BinDir)\undesign.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Undesign"
              Description="Undesign interface design and prototyping" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="UndesignIcon.exe" IconIndex="0" />
        </File>

        <!-- .undesign: Undesign's own format; Undesign is its default app. -->
        <ProgId Id="Undesign.Document" Description="Undesign Document" Icon="UndesignExe" IconIndex="0">
          <Extension Id="undesign" ContentType="application/x-undesign">
            <Verb Id="open" Command="Open" TargetFile="UndesignExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- SVG and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="Undesign.Image" Description="Image" Icon="UndesignExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Undesign.Image\shell\open\command" Value="&quot;[#UndesignExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.svg\OpenWithProgids" Name="Undesign.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.png\OpenWithProgids" Name="Undesign.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpg\OpenWithProgids" Name="Undesign.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpeg\OpenWithProgids" Name="Undesign.Image" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "undesign"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\undesign.exe" Name="FriendlyAppName" Value="Undesign" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\undesign.exe\shell\open\command" Value="&quot;[#UndesignExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\undesign.exe\SupportedTypes" Name=".undesign" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\undesign.exe\SupportedTypes" Name=".svg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\undesign.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\undesign.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\undesign.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\undesign.exe" Value="[#UndesignExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Undesign" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

<?if $(var.HasCli) = 1 ?>
      <Component Id="UndesignCli">
        <File Id="UndesignCliExe" Source="$(var.BinDir)\undesign-cli.exe" KeyPath="yes" />
      </Component>
<?endif?>
    </ComponentGroup>
  </Fragment>
</Wix>
