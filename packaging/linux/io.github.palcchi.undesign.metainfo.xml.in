<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>io.github.palcchi.undesign</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Undesign</name>
  <summary>Design and prototype user interfaces</summary>
  <developer id="io.github.palcchi">
    <name>The Undesign contributors</name>
  </developer>
  <description>
    <p>
      Undesign is an open-source, native interface design and prototyping tool. Lay out screens
      on an infinite canvas with frames, auto layout and constraints, build reusable components
      and variants, and link screens into clickable prototypes.
    </p>
    <ul>
      <li>Frames, vector shapes, text and images on an infinite canvas</li>
      <li>Auto layout and constraints for responsive designs</li>
      <li>Components, variants, shared styles and variables</li>
      <li>Prototyping with interactions and transitions, and a presentation mode</li>
      <li>Inspect panel with measurements and code snippets; SVG and PNG export</li>
      <li>Every action is a command, scriptable from a CLI and a JSON control channel</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.palcchi.undesign.desktop</launchable>
  <icon type="stock">io.github.palcchi.undesign</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/palcchi/undesign</url>
  <url type="bugtracker">https://github.com/palcchi/undesign/issues</url>
  <url type="help">https://github.com/palcchi/undesign</url>
  <categories>
    <!-- Freedesktop registered categories only ("Design" isn't one; the .desktop file says X-Design). -->
    <category>Graphics</category>
    <category>2DGraphics</category>
    <category>VectorGraphics</category>
  </categories>
  <keywords>
    <keyword>interface design</keyword>
    <keyword>prototyping</keyword>
    <keyword>ui</keyword>
    <keyword>wireframe</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#9fd3ff</color>
    <color type="primary" scheme_preference="dark">#0b5fa5</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>undesign</binary>
    <mediatype>application/x-undesign</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
