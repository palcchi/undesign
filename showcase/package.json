{
  "name": "undesign-showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "build:api": "tsc -p tsconfig.build.json --noEmit",
    "build": "npm run typecheck && npm run build:api && vite build",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test .test-dist/tests/*.test.js",
    "preview": "vite preview --host 127.0.0.1",
    "install:wasm": "node scripts/install-wasm.mjs"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "typescript": "5.7.3",
    "vite": "7.3.7"
  }
}
