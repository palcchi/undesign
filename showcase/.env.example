# Placeholder examples only. Configure real values only in a protected server environment.
NODE_ENV=production
PUBLIC_ORIGIN=https://your-showcase.example
SESSION_SECRET=replace-with-at-least-32-random-bytes
IP_HASH_SECRET=replace-with-a-different-at-least-32-random-bytes

# Required for the public Muse Spark relay. Never expose this to browser builds.
META_API_KEY=replace-with-server-only-provider-key

# Required for durable global/IP quotas. Keep the Supabase Secret API Key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-server-only-key

# Public demo limits are fixed in code: 6 requests/IP/minute, 100 requests globally/day,
# and at most 2,000 output tokens per request. The relay model is muse-spark-1.3.
