# Placeholder examples only. Configure real values only in a protected server environment.
# Production requires a canonical HTTPS origin, two distinct strong secrets, and durable quota storage.
NODE_ENV=production
PUBLIC_ORIGIN=https://your-showcase.example
SESSION_SECRET=replace-with-at-least-32-random-bytes
IP_HASH_SECRET=replace-with-a-different-at-least-32-random-bytes

# Required for production quota persistence. Keep the Supabase Secret API Key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-server-only-key

# Optional limits; defaults are 6 requests per IP per minute and 100 requests per UTC day.
RATE_LIMIT_PER_MIN=6
DAILY_BUDGET_REQUESTS=100
MAX_COMPLETION_TOKENS=2000
