{
  "name": "Undesign",
  "image": "mcr.microsoft.com/devcontainers/rust:1",
  "postCreateCommand": "rustup target add wasm32-unknown-unknown && cargo install trunk --locked",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Undesign web preview",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer"]
    }
  }
}
