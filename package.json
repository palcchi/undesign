{
  "name": "undesign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Undesign — a web-based visual design editor",
  "scripts": {
    "dev": "vite --host --port 5173",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "build:wasm": "scripts/build-wasm.sh",
    "preview": "vite preview --host --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml",
    "test:e2e": "node scripts/e2e-engine.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
